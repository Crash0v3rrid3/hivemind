# ~/.hivemind/rclone.conf — generated by `hivemind setup` (do not hand-edit the token).
#
# This holds the per-developer Google Drive OAuth token. It is the ONLY place a
# secret lives. Never commit it and never put it in ~/.hivemind.conf.
#
# `root_folder_id` scopes the remote to the shared `hivemind/` folder, extracted
# from gdrive_folder_url in ~/.hivemind.conf.
[hivemind]
type = drive
scope = drive
root_folder_id = 1AbCdEfGhIjKlMnOpQrStUvWxYz
token = {"access_token":"REPLACED_BY_SETUP","token_type":"Bearer","refresh_token":"REPLACED_BY_SETUP","expiry":"2026-01-01T00:00:00Z"}
