# ~/.hivemind.conf — human source of truth for the Hivemind CLI (TOML).
#
# The CLI generates the container's env from this file. Resolution order:
#   built-in defaults < ~/.hivemind.conf < environment overrides
#
# Secrets NEVER go in this file.

# Required. Your handle -> OWNER_HANDLE. Must match ^[a-z0-9][a-z0-9._-]*$
username = "alice"

# ---------------------------------------------------------------------------
# Mount backend — how the shared hive/ folder gets into the app container.
# Optional; defaults to "rclone".
#
#   "rclone"         Mount Google Drive with the rclone FUSE container. Needs a
#                    Drive OAuth token (created by `hivemind setup`, stored in
#                    ~/.hivemind/rclone.conf). Requires `gdrive_folder_url`.
#
#   "gdrive_desktop" Use Google Drive for Desktop (the official app) to sync the
#                    folder locally, and bind-mount it directly — no rclone, no
#                    OAuth client_id/secret, no token on disk. Requires
#                    `gdrive_desktop_path`.
# ---------------------------------------------------------------------------
mount_backend = "rclone"

# --- rclone backend -------------------------------------------------------
# Required when mount_backend = "rclone". Any Drive folder URL for the shared
# `hivemind/` folder; the folder id is extracted from /folders/<id> or ?id=<id>.
gdrive_folder_url = "https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz"

# --- gdrive_desktop backend ----------------------------------------------
# Required when mount_backend = "gdrive_desktop". Absolute host path to the
# `hivemind/` folder INSIDE your Google Drive for Desktop mount. Examples:
#   macOS:   "/Users/alice/Library/CloudStorage/GoogleDrive-alice@corp.com/My Drive/hivemind"
#   Windows: "G:\\My Drive\\hivemind"
#   Linux:   "/home/alice/GoogleDrive/My Drive/hivemind"  (via a Drive client)
# gdrive_desktop_path = "/Users/alice/Library/CloudStorage/GoogleDrive-alice@corp.com/My Drive/hivemind"

# ---------------------------------------------------------------------------
# Optional, both backends.
# ---------------------------------------------------------------------------

# MCP port on localhost (default 7777, range 1..65535).
mcp_port = 7777

# Explicit roster of member handles. Omit to use the admin-managed roster.json
# in the shared hive folder.
# roster = ["alice", "bob", "cara"]

# Host mount path used by the rclone FUSE backend (default "/mnt/hivemind").
# Ignored by the gdrive_desktop backend (which binds gdrive_desktop_path).
# mount_path = "/mnt/hivemind"

# Loop intervals in seconds (default 60 each).
# export_interval_sec = 60
# import_interval_sec = 60

# Semantic-search embeddings (default true). The app image is built LOCALLY from
# source bundled in this package — never pulled from a registry.
#   true  -> bakes the real embedder (BAAI/bge-small-en-v1.5 via torch); the first
#            `hivemind up` build is larger/slower but gives real semantic search.
#   false -> a lightweight, torch-free image using a deterministic fake embedder
#            (EMBEDDING_MODEL=fake) — good for offline/testing/quick trials.
# embeddings = true

# App image tag (default = CLI package version). A stack change ships as a new
# package version, so the image rebuilds automatically on upgrade.
# image_tag = "0.1.0"
