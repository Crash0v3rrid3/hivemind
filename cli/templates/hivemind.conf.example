# ~/.hivemind.conf — human source of truth for the Hivemind CLI (TOML).
#
# The CLI generates the stack runtime env from this file. Resolution order:
#   built-in defaults < ~/.hivemind.conf < environment overrides
#
# Secrets NEVER go in this file.

# Required. Your handle -> OWNER_HANDLE. Must match ^[a-z0-9][a-z0-9._-]*$
username = "alice"

# ---------------------------------------------------------------------------
# Deploy backend — how the stack is run. Optional; defaults to "nix".
#
#   "nix"     Run postgres + the app natively via Nix + process-compose (no
#             Docker). The default on macOS. Requires mount_backend =
#             "gdrive_desktop". If the nix binary is not installed, the CLI
#             transparently falls back to the "docker" backend.
#
#   "docker"  Run the stack with Docker Compose. Works with either mount backend.
# ---------------------------------------------------------------------------
deploy_backend = "nix"

# ---------------------------------------------------------------------------
# Mount backend — how the shared hive/ folder is reached. Optional; defaults to
# "rclone". The "nix" deploy backend requires "gdrive_desktop".
#
#   "gdrive_desktop" Use Google Drive for Desktop (the official app) to sync the
#                    folder locally; the stack reads it directly — no rclone, no
#                    OAuth, no token on disk. Requires gdrive_desktop_path.
#
#   "rclone"         (docker backend only) Mount Google Drive with the rclone
#                    FUSE container. Needs a Drive OAuth token (created by
#                    hivemind setup). Requires gdrive_folder_url.
# ---------------------------------------------------------------------------
mount_backend = "gdrive_desktop"

# --- gdrive_desktop backend (default) ------------------------------------
# Required when mount_backend = "gdrive_desktop". Absolute host path to the
# hivemind/ folder INSIDE your Google Drive for Desktop mount (macOS example):
gdrive_desktop_path = "/Users/alice/Library/CloudStorage/GoogleDrive-alice@corp.com/My Drive/hivemind"

# --- rclone backend (docker only) ----------------------------------------
# Required when mount_backend = "rclone". Any Drive folder URL for the shared
# hivemind/ folder; the folder id is extracted from /folders/<id> or ?id=<id>.
# gdrive_folder_url = "https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz"

# ---------------------------------------------------------------------------
# Optional, all backends.
# ---------------------------------------------------------------------------

# MCP port on localhost (default 7777, range 1..65535).
mcp_port = 7777

# Explicit roster of member handles. Omit to use the admin-managed roster.json.
# roster = ["alice", "bob", "cara"]

# Host mount path for the rclone FUSE backend (default "/mnt/hivemind"); ignored
# by gdrive_desktop.
# mount_path = "/mnt/hivemind"

# Loop intervals in seconds (default 60 each).
# export_interval_sec = 60
# import_interval_sec = 60

# Semantic-search embeddings (default true).
#   true  -> real embedder (BAAI/bge-small-en-v1.5 via fastembed/onnx). Under the
#            nix backend the model is fetched once into ~/.hivemind/nix-state and
#            reused offline thereafter.
#   false -> deterministic fake embedder (EMBEDDING_MODEL=fake) — instant, for
#            offline/testing/quick trials.
# embeddings = true

# App image tag for the docker backend (default = CLI version).
# image_tag = "0.1.0"
