{
  "name": "@browserstack/hivemind",
  "version": "0.1.0",
  "description": "Hivemind host CLI — provisions and operates a local, serverless, append-only shared team memory exposed over MCP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hivemind": "dist/cli.js"
  },
  "files": [
    "dist/",
    "templates/",
    "app/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.mjs && node scripts/bundle-app.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fmt": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
